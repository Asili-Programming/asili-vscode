{
  "name": "asili",
  "displayName": "Asili",
  "description": "Asili language support and Pata project workflows: build, run, test, debug, and more.",
  "version": "0.5.0",
  "publisher": "asili",
  "license": "GPL-2.0-only",
  "icon": "assets/asili-extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Asili-Programming/asili-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Asili-Programming/asili-vscode/issues"
  },
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:pata.toml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "asili",
        "aliases": [
          "Asili"
        ],
        "extensions": [
          ".as",
          ".asi"
        ],
        "icon": {
          "light": "./assets/asili-file-light.png",
          "dark": "./assets/asili-file-dark.png"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "pata-manifest",
        "aliases": [
          "Pata Manifest"
        ],
        "filenames": [
          "pata.toml",
          "pata.lock"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "asili",
        "scopeName": "source.asili",
        "path": "./syntaxes/asili.tmLanguage.json"
      },
      {
        "language": "pata-manifest",
        "scopeName": "source.pata-manifest",
        "path": "./syntaxes/pata-manifest.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "asili",
        "path": "./snippets/asili.code-snippets"
      }
    ],
    "configuration": {
      "title": "Asili",
      "properties": {
        "asili.serverPath": {
          "type": "string",
          "default": "",
          "description": "%setting.serverPath%"
        },
        "asili.serverArgs": {
          "type": "array",
          "default": [],
          "description": "%setting.serverArgs%"
        },
        "asili.cliPath": {
          "type": "string",
          "default": "pata",
          "description": "%setting.cliPath%"
        },
        "asili.linterPath": {
          "type": "string",
          "default": "pata-lint",
          "description": "%setting.linterPath%"
        },
        "asili.debuggerPath": {
          "type": "string",
          "default": "",
          "description": "%setting.debuggerPath%"
        }
      }
    },
    "commands": [
      {
        "command": "asili.runTest",
        "title": "%command.runTest%",
        "category": "Asili"
      },
      {
        "command": "asili.lintFile",
        "title": "%command.lintFile%",
        "category": "Asili"
      },
      {
        "command": "asili.lintWorkspace",
        "title": "%command.lintWorkspace%",
        "category": "Asili"
      },
      {
        "command": "asili.build",
        "title": "%command.build%",
        "category": "Asili"
      },
      {
        "command": "asili.buildTimings",
        "title": "%command.buildTimings%",
        "category": "Asili"
      },
      {
        "command": "asili.run",
        "title": "%command.run%",
        "category": "Asili"
      },
      {
        "command": "asili.runWithTrace",
        "title": "%command.runWithTrace%",
        "category": "Asili"
      },
      {
        "command": "asili.selectTarget",
        "title": "%command.selectTarget%",
        "category": "Asili"
      },
      {
        "command": "asili.selectMode",
        "title": "%command.selectMode%",
        "category": "Asili"
      },
      {
        "command": "asili.test",
        "title": "%command.test%",
        "category": "Asili"
      },
      {
        "command": "asili.testCoverage",
        "title": "%command.testCoverage%",
        "category": "Asili"
      },
      {
        "command": "asili.formatProject",
        "title": "%command.formatProject%",
        "category": "Asili"
      },
      {
        "command": "asili.formatCheck",
        "title": "%command.formatCheck%",
        "category": "Asili"
      },
      {
        "command": "asili.verify",
        "title": "%command.verify%",
        "category": "Asili"
      },
      {
        "command": "asili.newProject",
        "title": "%command.newProject%",
        "category": "Asili"
      },
      {
        "command": "asili.addDependency",
        "title": "%command.addDependency%",
        "category": "Asili"
      },
      {
        "command": "asili.removeDependency",
        "title": "%command.removeDependency%",
        "category": "Asili"
      },
      {
        "command": "asili.repl",
        "title": "%command.repl%",
        "category": "Asili"
      },
      {
        "command": "asili.workspaceInfo",
        "title": "%command.workspaceInfo%",
        "category": "Asili"
      },
      {
        "command": "asili.runArtifact",
        "title": "%command.runArtifact%",
        "category": "Asili"
      },
      {
        "command": "asili.openTrace",
        "title": "%command.openTrace%",
        "category": "Asili"
      },
      {
        "command": "asili.showTools",
        "title": "%command.showTools%",
        "category": "Asili"
      },
      {
        "command": "asili.restartServer",
        "title": "%command.restartServer%",
        "category": "Asili"
      },
      {
        "command": "asili.debug",
        "title": "%command.debug%",
        "category": "Asili"
      }
    ],
    "taskDefinitions": [
      {
        "type": "pata",
        "required": [
          "args"
        ],
        "properties": {
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "%task.args%"
          },
          "cwd": {
            "type": "string",
            "description": "%task.cwd%"
          },
          "label": {
            "type": "string",
            "description": "%task.label%"
          }
        }
      }
    ],
    "debuggers": [
      {
        "type": "asili",
        "label": "Asili",
        "languages": [
          "asili"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "%debug.program%"
              },
              "args": {
                "type": "array",
                "default": [],
                "description": "%debug.args%"
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "%debug.cwd%"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "asili",
            "request": "launch",
            "name": "%debug.launchName%",
            "program": "${workspaceFolder}/src/kuu.as",
            "cwd": "${workspaceFolder}",
            "args": []
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "asili"
      }
    ],
    "walkthroughs": [
      {
        "id": "asili.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "project",
            "title": "%walkthrough.project.title%",
            "description": "%walkthrough.project.description%",
            "media": {
              "markdown": "docs/walkthrough/project.md"
            },
            "completionEvents": [
              "onCommand:asili.newProject"
            ]
          },
          {
            "id": "run",
            "title": "%walkthrough.run.title%",
            "description": "%walkthrough.run.description%",
            "media": {
              "markdown": "docs/walkthrough/run.md"
            },
            "completionEvents": [
              "onCommand:asili.run"
            ]
          },
          {
            "id": "test",
            "title": "%walkthrough.test.title%",
            "description": "%walkthrough.test.description%",
            "media": {
              "markdown": "docs/walkthrough/test.md"
            },
            "completionEvents": [
              "onCommand:asili.test"
            ]
          },
          {
            "id": "debug",
            "title": "%walkthrough.debug.title%",
            "description": "%walkthrough.debug.description%",
            "media": {
              "markdown": "docs/walkthrough/debug.md"
            },
            "completionEvents": [
              "onCommand:asili.debug"
            ]
          },
          {
            "id": "language",
            "title": "%walkthrough.language.title%",
            "description": "%walkthrough.language.description%",
            "media": {
              "markdown": "docs/walkthrough/language.md"
            },
            "completionEvents": [
              "onLanguage:asili"
            ]
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "asili.run",
          "when": "editorLangId == asili",
          "group": "navigation"
        },
        {
          "command": "asili.debug",
          "when": "editorLangId == asili",
          "group": "navigation"
        },
        {
          "command": "asili.runWithTrace",
          "when": "editorLangId == asili",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "asili.run",
          "when": "resourceLangId == asili",
          "group": "navigation"
        },
        {
          "command": "asili.build",
          "when": "resourceLangId == asili",
          "group": "navigation"
        },
        {
          "command": "asili.debug",
          "when": "resourceLangId == asili",
          "group": "navigation"
        },
        {
          "command": "asili.runWithTrace",
          "when": "resourceLangId == asili",
          "group": "navigation"
        },
        {
          "command": "asili.runArtifact",
          "when": "resourceExtname == .asb",
          "group": "navigation"
        },
        {
          "command": "asili.addDependency",
          "when": "resourceFilename == pata.toml",
          "group": "navigation"
        },
        {
          "command": "asili.removeDependency",
          "when": "resourceFilename == pata.toml",
          "group": "navigation"
        },
        {
          "command": "asili.newProject",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "asili.trace",
        "contents": "%view.traceWelcome%",
        "when": "view == asili.trace"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "asili.trace",
          "name": "%view.trace%"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check-types && npm run bundle",
    "check-types": "tsc -p ./ --noEmit",
    "bundle": "node esbuild.js",
    "compile": "npm run check-types && npm run bundle",
    "test": "node --test tests/manifest.test.cjs && node ./tests/runTests.js",
    "package": "node scripts/package.js",
    "build-tools": "bash scripts/build-tools.sh",
    "build-lsp": "bash scripts/build-lsp.sh",
    "watch": "node esbuild.js --watch"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.145.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  }
}
